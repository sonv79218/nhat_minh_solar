rules_version = '2';

// ============================================
// FIRESTORE SECURITY RULES
// Điện Mặt Trời Nhật Minh
//
// Mô hình phân quyền hiện tại:
// - `articles` + `article_categories`:
//     • Đọc   : công khai cho bài đã xuất bản + danh mục.
//                Tài khoản đã đăng nhập đọc được cả bản nháp.
//     • Ghi   : MỌI tài khoản đã đăng nhập Firebase Authentication
//                đều tạo / sửa / xoá / lưu nháp được.
//                KHÔNG yêu cầu role admin, KHÔNG yêu cầu Custom Claims.
// - `contact_requests`: giữ nguyên — khách gửi form, admin đọc/quản lý.
// - `users`: KHÔNG cho người dùng tự gán role "admin" (chặn leo thang
//           đặc quyền). Admin do Firebase Console phân quyền.
//
// Deploy:
//   npx firebase deploy --only firestore:rules --project nhat-minh-solar
// ============================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------

    /** Người dùng đã đăng nhập Firebase Authentication. */
    function signedIn() {
      return request.auth != null;
    }

    /**
     * Admin — xác định bằng document `users/{uid}` có `role == "admin"`.
     * Dùng cho `contact_requests` và quản lý `users`.
     * KHÔNG dùng cho bài viết / danh mục bài viết.
     *
     * Lưu ý: `get()` trong Rules đọc document trực tiếp, không bị rules
     * của collection `users` chặn.
     */
    function isAdmin() {
      return signedIn() &&
        get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == "admin";
    }

    // ==========================================
    // ARTICLES — bài viết & công trình
    // ==========================================
    match /articles/{articleId} {

      // Đọc:
      //  • Khách (chưa đăng nhập) chỉ đọc được bài `status == "published"`.
      //  • Tài khoản đã đăng nhập đọc được cả bản nháp (dùng cho màn hình quản lý).
      allow read: if resource.data.status == "published" || signedIn();

      // Ghi: mọi tài khoản đã đăng nhập đều tạo / sửa / xoá / lưu nháp được.
      allow create, update, delete: if signedIn();
    }

    // ==========================================
    // ARTICLE CATEGORIES — danh mục bài viết
    // ==========================================
    match /article_categories/{categoryId} {
      // Danh mục là dữ liệu công khai
      allow read: if true;

      // Ghi: mọi tài khoản đã đăng nhập đều quản lý được.
      allow create, update, delete: if signedIn();
    }

    // ==========================================
    // CONTACT REQUESTS — yêu cầu liên hệ (giữ nguyên)
    // ==========================================
    match /contact_requests/{requestId} {
      // Khách gửi form liên hệ
      allow create: if true;

      // Chỉ admin đọc / cập nhật / xoá
      allow read, update, delete: if isAdmin();
    }

    // ==========================================
    // SOLUTIONS — giải pháp
    // ==========================================
    match /solutions/{solutionId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // PRODUCTS / CATEGORIES / BANNERS / PROJECTS / BLOGS
    // ==========================================
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ==========================================
    // USERS — hồ sơ người dùng & phân quyền
    // ==========================================
    match /users/{userId} {

      // Người dùng tạo được hồ sơ của chính mình,
      // nhưng KHÔNG được tự gán role "admin" (chặn leo thang đặc quyền).
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.get('role', '') != "admin";

      // Đọc: chính mình hoặc admin
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == userId);

      // Sửa: admin, hoặc chính mình nhưng không được đụng tới role.
      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.get('role', '') != "admin"
          && resource.data.get('role', '') != "admin"
        );

      allow delete: if isAdmin();
    }

    // ==========================================
    // CONTACTS / ORDERS
    // ==========================================
    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
